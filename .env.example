# Docker Compose reads this file selector from .env itself.
AGENT_ENV_FILE=.env
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# DingTalk internal app. Client ID is the AppKey, not the numeric appId.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=dingpwa0i4c0yn5si1ye
DINGTALK_API_BASE_URL=https://api.dingtalk.com
# Direct AI Card/A2UI transport. Keep enabled after API contract validation.
# A2UI card API is currently unavailable and is intentionally disabled.
DINGTALK_A2UI_ENABLED=false
DINGTALK_A2UI_CATALOG_ID=https://dingtalk.com/card/a2ui/catalogs/public/catalog.json
DINGTALK_A2UI_MAX_MESSAGE_BYTES=262144
DINGTALK_A2UI_MAX_COMPONENTS=200
DINGTALK_A2UI_UPDATE_PATH=/v1.0/card/ai/instances
DINGTALK_DIRECTORY_FACTORY_DEPT_ID=706188394
# Native AI streaming-card template (must be published). Variable is `content`.
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_APPROVAL_CARD_TEMPLATE_ID=
DINGTALK_CLARIFICATION_CARD_TEMPLATE_ID=
DINGTALK_CLARIFICATION_CARD_TTL_MS=86400000
DINGTALK_CARD_VARIABLE=content
# Set only after the template binds this text variable in its processing/output states.
# DINGTALK_CARD_ACTIVITY_VARIABLE=activity
# Enable only after the template binds activity in its PROCESSING state.
# DINGTALK_CARD_ACTIVITY_IN_PROCESSING=true

# Active text model: switch between Tokenshop GPT and Antigravity Gemini here.
MODEL_PROVIDER=gemini
# Tokenshop Responses-compatible relay. Keep these values to switch back later.
TOKENSHOP_MODEL_BASE_URL=
TOKENSHOP_MODEL_API_KEY=
TOKENSHOP_MODEL_NAME=gpt-6.1-sol
# Antigravity Responses bridge. GEMINI_MODEL_API_KEY defaults to IMAGE_API_KEY
# when both use the same Antigravity account key.
GEMINI_MODEL_BASE_URL=http://43.142.171.134:8080/v1
GEMINI_MODEL_API_KEY=
GEMINI_MODEL_NAME=gemini-3.8-flash-high
# Fills only missing Responses caps for the configured Gemini model. 0 disables;
# explicit caller limits stay unchanged. Range 0..64000 (default 32768).
GEMINI_RESPONSES_DEFAULT_MAX_OUTPUT_TOKENS=32768
# Legacy aliases remain supported for existing deployments: MODEL_BASE_URL,
# MODEL_API_KEY and MODEL_NAME are used as the Tokenshop settings when the
# matching TOKENSHOP_MODEL_* value is empty.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=gpt-5.6-sol
MODEL_REQUEST_MAX_ATTEMPTS=6
MODEL_REQUEST_RETRY_BUDGET_MS=1200000
MODEL_REQUEST_ATTEMPT_TIMEOUT_MS=180000
MODEL_REVIEW_TIMEOUT_MS=180000
MODEL_REVIEW_MAX_ATTEMPTS=2
MODEL_REVIEW_RETRY_BUDGET_MS=360000
# Cumulative wall-clock budget across all reviews and revisions of one task.
TASK_REVIEW_BUDGET_MS=360000
MODEL_REVIEW_PROVIDER=primary
# shadow records contract/evidence differences without changing answers; enforce requires verified completion.
TASK_WORKFLOW_MODE=shadow

# Shared service credentials for the official read-mostly commerce MCP servers.
# Keep real values only in .env; never commit them.
LINGXING_MCP_KEY=
SIF_MCP_KEY=
# CrossBorderOps scope API; keep the token identical to the backend setting.
CROSSBORDEROPS_API_URL=http://crossborderops-backend:5000
CROSSBORDEROPS_INTERNAL_TOKEN=

CODEX_BIN=codex
CODEX_HOME=/var/lib/codex
CODEX_WORKDIR=/app/workspaces
DWS_BIN=dws
DWS_CONFIG_DIR=/var/lib/dws
# Optional exact hosts verified reachable directly; applies only to DWS children.
DWS_NO_PROXY=
ZINIAO_BIN=ziniao-cli
ZINIAO_USERS_DIR=/home/agent/.ziniao-cli/users
ZINIAO_REMOTE_HOST=192.168.3.75
ZINIAO_REMOTE_USER=jennov
ZINIAO_REMOTE_KEY_PATH=/home/agent/.ziniao-cli/ssh/id_ed25519
ZINIAO_REMOTE_KNOWN_HOSTS_PATH=/home/agent/.ziniao-cli/ssh/known_hosts
DWS_BOT_PROFILE=
# Keep disabled until a real DingTalk card verifies sender identity and rendering.
DINGTALK_STREAMING_CARDS=true
SKILLS_DIR=/app/skills

# Use independent random values in production.
POSTGRES_USER=agent
POSTGRES_PASSWORD=
POSTGRES_DB=agent
INTERNAL_API_TOKEN=

# Operational limits.
QUERY_OPTIMIZATION_MODE=shadow
TASK_SIMPLE_QUERY_BUDGET_MS=300000
TASK_GENERAL_QUERY_BUDGET_MS=900000
TASK_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=90
MAX_CONCURRENT_USERS=30
MEDIA_MAX_BYTES=52428800

# This machine currently cannot reach Docker Hub directly. Uncomment for rebuilds here.
# NODE_IMAGE=m.daocloud.io/docker.io/library/node:22-bookworm-slim
MODEL_TOOL_COMPAT_PROXY=true

# Native Gemini image generation/editing. This channel is independent from
# MODEL_* (the text Agent Responses relay). Keep the API key only in .env or a
# secret manager. IMAGE_BASE_URL may point at an approved Gemini-compatible
# gateway; the adapter appends /v1beta/models/<model>:generateContent.
IMAGE_BASE_URL=http://43.142.171.134:8080/antigravity
IMAGE_API_KEY=
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_PROVIDER=gemini
# Optional JSON registry for additional providers. Credentials should be
# referenced with apiKeyEnv/baseUrlEnv/modelEnv instead of being embedded.
IMAGE_PROVIDERS_JSON=
IMAGE_TIMEOUT_MS=180000

# File worker rollout: off, test (only listed type:id surfaces), or all.
# Supply the same random 32+ character secret to gateway and file-worker via
# Compose environment. Never put model or DWS credentials in the worker.
FILE_WORKER_MODE=all
FILE_WORKER_TEST_SURFACES=
FILE_WORKER_SECRET=

EMBEDDING_BASE_URL=https://llm-6kvw8x5ljfj6lhth.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
RERANK_MODEL=qwen3.7-text-rerank
EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_ENABLED=false
KNOWLEDGE_TEST_USERS=
KNOWLEDGE_DIR=./data/knowledge
KNOWLEDGE_SYNC_INTERVAL_MS=900000
KNOWLEDGE_VISION_CONCURRENCY=2
KNOWLEDGE_MAX_SOURCE_BYTES=268435456
EMBEDDING_API_KEY=
