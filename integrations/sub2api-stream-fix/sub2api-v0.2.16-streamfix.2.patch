+func TestAntigravityResponsesFailureHasProtocolTerminal(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	c, recorder := newAntigravityCompatContext(http.MethodPost, "/", nil)
+	writer := newAntigravityClientWriter(c.Writer, c.Writer, "test")
+	adapter := newAntigravityResponsesStreamAdapter("gemini-test")
+	adapter.WriteError(writer, "empty_stream")
+	adapter.WriteError(writer, "empty_stream")
+	body := recorder.Body.String()
+	require.Contains(t, body, "event: response.created")
+	require.Equal(t, 1, strings.Count(body, "event: response.failed"))
+	require.NotContains(t, body, "event: response.completed")
+	require.NotContains(t, body, "event: error")
+	var terminal, created map[string]any
+	for _, line := range strings.Split(body, "\n") {
+		if strings.HasPrefix(line, "data: ") && strings.Contains(line, `"type":"response.created"`) {
+			require.NoError(t, json.Unmarshal([]byte(strings.TrimPrefix(line, "data: ")), &created))
+		}
+		if strings.HasPrefix(line, "data: ") && strings.Contains(line, `"type":"response.failed"`) {
+			require.NoError(t, json.Unmarshal([]byte(strings.TrimPrefix(line, "data: ")), &terminal))
+		}
+	}
+	require.NotNil(t, terminal)
+	require.NotNil(t, created)
+	createdResponse := created["response"].(map[string]any)
+	require.Equal(t, []any{}, createdResponse["output"])
+	response := terminal["response"].(map[string]any)
+	require.Equal(t, []any{}, response["output"])
+	require.Equal(t, createdResponse["id"], response["id"])
+	require.Equal(t, createdResponse["created_at"], response["created_at"])
+	require.Equal(t, "failed", response["status"])
+	require.NotEmpty(t, response["id"])
+	require.Greater(t, response["created_at"].(float64), float64(0))
+	require.Equal(t, "empty_stream", response["error"].(map[string]any)["message"])
+	require.Equal(t, "empty_stream", response["error"].(map[string]any)["code"])
+	require.Greater(t, terminal["sequence_number"].(float64), float64(0))
+}
