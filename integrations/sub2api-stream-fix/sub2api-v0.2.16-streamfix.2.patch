+func TestStreamingProcessorDirectAndWrappedResponse(t *testing.T) {
+	payload := `{"responseId":"r1","candidates":[{"content":{"role":"model","parts":[{"text":"hello"}]},"finishReason":"STOP"}]}`
+	for _, wrapped := range []bool{false, true} {
+		p := NewStreamingProcessor("gemini-test")
+		line := payload
+		if wrapped {
+			line = `{"response":` + payload + `}`
+		}
+		events := string(p.ProcessLine("data: " + line))
+		if !p.HasContent() || !strings.Contains(events, "hello") {
+			t.Fatalf("wrapped=%v dropped output: %s", wrapped, events)
+		}
+		d := p.Diagnostics()
+		if d.Candidates != 1 || d.FinishReasons["STOP"] != 1 {
+			t.Fatalf("bad diagnostics: %+v", d)
+		}
+		if wrapped && d.WrappedFrames != 1 || !wrapped && d.DirectFrames != 1 {
+			t.Fatalf("bad shape: %+v", d)
+		}
+	}
+}
+func TestStreamingProcessorDiagnosticsNeverRetainPayload(t *testing.T) {
+	p := NewStreamingProcessor("gemini-test")
+	for _, line := range []string{
+		`data: {"error":{"code":429,"status":"RESOURCE_EXHAUSTED","message":"PRIVATE_SECRET"}}`,
+		`data: {"PRIVATE_SECRET":"PRIVATE_SECRET"}`,
+		`data: not-json-PRIVATE_SECRET`,
+		`data: {"candidates":[{"finishReason":"PRIVATE_SECRET"}]}`,
+	} {
+		p.ProcessLine(line)
+	}
+	b, _ := json.Marshal(p.Diagnostics())
+	if strings.Contains(string(b), "PRIVATE_SECRET") {
+		t.Fatal("private content retained")
+	}
+	d := p.Diagnostics()
+	if d.ErrorFrames != 1 || d.ErrorCodes[429] != 1 || d.InvalidJSONFrames != 1 || d.UnknownShapeFrames != 1 || d.FinishReasons["UNKNOWN"] != 1 {
+		t.Fatalf("bad diagnostics: %s", b)
+	}
+	if p.HasContent() {
+		t.Fatal("empty/error frames counted as content")
+	}
+}
+func TestStreamingProcessorDirectFunctionCall(t *testing.T) {
+	p := NewStreamingProcessor("gemini-test")
+	events := p.ProcessLine(`data: {"candidates":[{"content":{"parts":[{"functionCall":{"name":"lookup","args":{"id":"a"}}}]} }]}`)
+	if !p.HasContent() || !strings.Contains(string(events), "lookup") {
+		t.Fatalf("tool call dropped: %s", events)
+	}
+}
+
+func TestStreamingProcessorWrappedErrorAndUsageOnly(t *testing.T) {
+	p := NewStreamingProcessor("gemini-test")
+	p.ProcessLine(`data: {"response":{"error":{"code":503,"status":"UNAVAILABLE","message":"private"}}}`)
+	p.ProcessLine(`data: {"usageMetadata":{"promptTokenCount":42}}`)
+	_, usage := p.Finish()
+	if p.HasContent() || usage.InputTokens != 42 || p.Diagnostics().ErrorCodes[503] != 1 {
+		t.Fatalf("bad usage/error handling: %+v %+v", usage, p.Diagnostics())
+	}
+}
+
+func TestStreamingProcessorNoContentMaxTokensPreservesDiagnostics(t *testing.T) {
+	p := NewStreamingProcessor("gemini-test")
+	events := string(p.ProcessLine(`data: {"response":{"candidates":[{"finishReason":"MAX_TOKENS"}],"usageMetadata":{"promptTokenCount":114583,"candidatesTokenCount":0,"thoughtsTokenCount":8192}}}`))
+	if p.HasContent() || !strings.Contains(events, `"stop_reason":"max_tokens"`) {
+		t.Fatalf("unexpected content or stop reason: %s", events)
+	}
+	d := p.Diagnostics()
+	if d.PromptTokens != 114583 || d.CandidateTokens != 0 || d.ThoughtTokens != 8192 || d.FinishReasons["MAX_TOKENS"] != 1 {
+		t.Fatalf("bad token diagnostics: %+v", d)
+	}
+	_, usage := p.Finish()
+	if usage.OutputTokens != 8192 {
+		t.Fatalf("lost hidden thought usage: %+v", usage)
+	}
+}
