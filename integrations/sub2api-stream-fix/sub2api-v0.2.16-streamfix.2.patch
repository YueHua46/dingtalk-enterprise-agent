+package antigravity
+
+import "encoding/json"
+
+// StreamDiagnostics never retains upstream payloads, messages, text, tool arguments,
+// arbitrary JSON keys, or provider-supplied strings; only counters and known enums.
+type StreamDiagnostics struct {
+	PromptTokens       int            `json:"prompt_tokens"`
+	CandidateTokens    int            `json:"candidate_tokens"`
+	ThoughtTokens      int            `json:"thought_tokens"`
+	DataFrames         int            `json:"data_frames"`
+	WrappedFrames      int            `json:"wrapped_frames"`
+	DirectFrames       int            `json:"direct_frames"`
+	InvalidJSONFrames  int            `json:"invalid_json_frames"`
+	UnknownShapeFrames int            `json:"unknown_shape_frames"`
+	ErrorFrames        int            `json:"error_frames"`
+	Candidates         int            `json:"candidates"`
+	FinishReasons      map[string]int `json:"finish_reasons,omitempty"`
+	ErrorCodes         map[int]int    `json:"error_codes,omitempty"`
+	ErrorStatuses      map[string]int `json:"error_statuses,omitempty"`
+}
+
+func (p *StreamingProcessor) Diagnostics() StreamDiagnostics { return p.diagnostics }
+func (p *StreamingProcessor) recordFinishReason(reason string) {
+	if reason == "" {
+		return
+	}
+	switch reason {
+	case "STOP", "MAX_TOKENS", "SAFETY", "RECITATION", "OTHER", "BLOCKLIST", "PROHIBITED_CONTENT", "SPII", "MALFORMED_FUNCTION_CALL", "IMAGE_SAFETY", "UNEXPECTED_TOOL_CALL", "NO_IMAGE":
+	default:
+		reason = "UNKNOWN"
+	}
+	if p.diagnostics.FinishReasons == nil {
+		p.diagnostics.FinishReasons = map[string]int{}
+	}
+	p.diagnostics.FinishReasons[reason]++
+}
+func (p *StreamingProcessor) recordUpstreamError(raw json.RawMessage) {
+	p.diagnostics.ErrorFrames++
+	var e struct {
+		Code   int    `json:"code"`
+		Status string `json:"status"`
+	}
+	if json.Unmarshal(raw, &e) != nil {
+		return
+	}
+	if e.Code >= 100 && e.Code <= 599 {
+		if p.diagnostics.ErrorCodes == nil {
+			p.diagnostics.ErrorCodes = map[int]int{}
+		}
+		p.diagnostics.ErrorCodes[e.Code]++
+	}
+	switch e.Status {
+	case "INVALID_ARGUMENT", "UNAUTHENTICATED", "PERMISSION_DENIED", "NOT_FOUND", "RESOURCE_EXHAUSTED", "FAILED_PRECONDITION", "ABORTED", "OUT_OF_RANGE", "UNIMPLEMENTED", "INTERNAL", "UNAVAILABLE", "DATA_LOSS", "DEADLINE_EXCEEDED", "CANCELLED":
+	default:
+		e.Status = "UNKNOWN"
+	}
+	if p.diagnostics.ErrorStatuses == nil {
+		p.diagnostics.ErrorStatuses = map[string]int{}
+	}
+	p.diagnostics.ErrorStatuses[e.Status]++
+}
