+func TestStreamingProcessorNoContentMaxTokensPreservesDiagnostics(t *testing.T) {
+	p := NewStreamingProcessor("gemini-test")
+	events := string(p.ProcessLine(`data: {"response":{"candidates":[{"finishReason":"MAX_TOKENS"}],"usageMetadata":{"promptTokenCount":114583,"candidatesTokenCount":0,"thoughtsTokenCount":8192}}}`))
+	if p.HasContent() || !strings.Contains(events, `"stop_reason":"max_tokens"`) {
+		t.Fatalf("unexpected content or stop reason: %s", events)
+	}
+	d := p.Diagnostics()
+	if d.PromptTokens != 114583 || d.CandidateTokens != 0 || d.ThoughtTokens != 8192 || d.FinishReasons["MAX_TOKENS"] != 1 {
+		t.Fatalf("bad token diagnostics: %+v", d)
+	}
+	_, usage := p.Finish()
+	if usage.OutputTokens != 8192 {
+		t.Fatalf("lost hidden thought usage: %+v", usage)
+	}
+}
