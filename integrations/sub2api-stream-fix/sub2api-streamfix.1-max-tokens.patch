+func TestAntigravityCompatResponsesNoContentMaxTokensIsIncomplete(t *testing.T) {
+	for _, wrapped := range []bool{false, true} {
+		for _, keepalive := range []bool{false, true} {
+			name := fmt.Sprintf("wrapped=%t/keepalive=%t", wrapped, keepalive)
+			t.Run(name, func(t *testing.T) {
+				c, recorder := newAntigravityCompatContext(http.MethodPost, "/", nil)
+				writer := newAntigravityClientWriter(c.Writer, c.Writer, "test")
+				session := newAntigravityCompatStreamSession("gemini-3.1-pro-high", time.Now().Add(-time.Minute), newAntigravityResponsesStreamAdapter("gemini-3.1-pro-high"), writer)
+				if keepalive {
+					session.writePreContentKeepalive(time.Now())
+				}
+				payload := `{"responseId":"r_budget","candidates":[{"finishReason":"MAX_TOKENS"}],"usageMetadata":{"promptTokenCount":114583,"candidatesTokenCount":0,"thoughtsTokenCount":8192}}`
+				if wrapped {
+					payload = `{"response":` + payload + `}`
+				}
+				session.consume("data: " + payload)
+				require.False(t, session.hasMeaningfulData())
+				result, err := handleAntigravityCompatEmptyStream(c, session)
+				require.NoError(t, err)
+				require.NotNil(t, result)
+				require.Equal(t, 8192, result.usage.OutputTokens)
+				body := recorder.Body.String()
+				require.Equal(t, 1, strings.Count(body, "event: response.incomplete"))
+				require.NotContains(t, body, "event: response.completed")
+				require.NotContains(t, body, "event: response.failed")
+				require.NotContains(t, body, "empty_stream")
+				for _, line := range strings.Split(body, "\n") {
+					if strings.HasPrefix(line, "data: ") && strings.Contains(line, `"type":"response.incomplete"`) {
+						var event map[string]any
+						require.NoError(t, json.Unmarshal([]byte(strings.TrimPrefix(line, "data: ")), &event))
+						response := event["response"].(map[string]any)
+						require.Equal(t, "incomplete", response["status"])
+						require.Equal(t, []any{}, response["output"])
+						require.Equal(t, "max_output_tokens", response["incomplete_details"].(map[string]any)["reason"])
+						require.Equal(t, float64(8192), response["usage"].(map[string]any)["output_tokens"])
+						return
+					}
+				}
+				t.Fatal("missing incomplete terminal")
+			})
+		}
+	}
+}
