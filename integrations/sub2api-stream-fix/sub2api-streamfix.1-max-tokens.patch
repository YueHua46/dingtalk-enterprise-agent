+func TestAntigravityCompatResponsesHTTPMaxTokensTerminal(t *testing.T) {
+	payload := `data: {"response":{"responseId":"r_budget_http","candidates":[{"finishReason":"MAX_TOKENS"}],"usageMetadata":{"promptTokenCount":114583,"candidatesTokenCount":0,"thoughtsTokenCount":8192}}}` + "\n\n"
+	upstream := &queuedHTTPUpstreamStub{responses: []*http.Response{{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": []string{"text/event-stream"}}, Body: io.NopCloser(strings.NewReader(payload))}}}
+	svc := newAntigravityCompatService(config.GatewayConfig{MaxLineSize: defaultMaxLineSize}, upstream)
+	body := []byte(`{"model":"gemini-3.1-pro-high","input":"ok","stream":true}`)
+	c, recorder := newAntigravityCompatContext(http.MethodPost, "/v1/responses", body)
+	result, err := svc.ForwardAsResponses(context.Background(), c, newAntigravityCompatAccount(AccountTypeOAuth), body, nil)
+	require.NoError(t, err)
+	require.NotNil(t, result)
+	require.Len(t, upstream.requestBodies, 1)
+	require.Equal(t, http.StatusOK, recorder.Code)
+	require.Equal(t, "text/event-stream", recorder.Header().Get("Content-Type"))
+	responseBody := recorder.Body.String()
+	require.Equal(t, 1, strings.Count(responseBody, "event: response.incomplete"))
+	require.Contains(t, responseBody, `"reason":"max_output_tokens"`)
+	require.Contains(t, responseBody, `"output":[]`)
+	require.Contains(t, responseBody, `"output_tokens":8192`)
+	require.NotContains(t, responseBody, "event: response.completed")
+	require.NotContains(t, responseBody, "event: response.failed")
+	require.NotContains(t, responseBody, "empty_stream")
+}
