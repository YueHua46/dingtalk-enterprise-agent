+func TestAntigravityCompatResponsesOutputBudgetForwarding(t *testing.T) {
+	for _, tc := range []struct {
+		name, extra string
+		want        int64
+	}{
+		{"omitted uses bridge default", "", 8192},
+		{"explicit budget preserved", `,"max_output_tokens":24576`, 24576},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			upstream := &queuedHTTPUpstreamStub{responses: []*http.Response{antigravityCompatSuccessResponse()}}
+			svc := newAntigravityCompatService(config.GatewayConfig{MaxLineSize: defaultMaxLineSize}, upstream)
+			body := []byte(`{"model":"gemini-3.1-pro-high","input":"ok","stream":true` + tc.extra + `}`)
+			c, _ := newAntigravityCompatContext(http.MethodPost, "/v1/responses", body)
+			_, err := svc.ForwardAsResponses(context.Background(), c, newAntigravityCompatAccount(AccountTypeOAuth), body, nil)
+			require.NoError(t, err)
+			require.Len(t, upstream.requestBodies, 1)
+			require.Equal(t, tc.want, gjson.GetBytes(upstream.requestBodies[0], "request.generationConfig.maxOutputTokens").Int())
+			require.False(t, gjson.GetBytes(upstream.requestBodies[0], "request.generationConfig.thinkingConfig").Exists())
+		})
+	}
+}
