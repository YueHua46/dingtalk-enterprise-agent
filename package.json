{
  "name": "dingtalk-enterprise-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "migrate": "node scripts/migrate.mjs",
    "test": "vitest run",
    "eval:listing": "npm run build && node scripts/eval-listing.mjs",
    "test:watch": "vitest",
    "test:postgres": "node scripts/postgres-smoke.mjs",
    "test:queue": "node scripts/queue-smoke.mjs",
    "test:clamav": "node scripts/clamav-smoke.mjs",
    "test:codex-restart": "node scripts/codex-restart-smoke.mjs",
    "test:codex-thread": "node scripts/codex-thread-smoke.mjs",
    "test:codex-model": "node scripts/codex-model-smoke.mjs",
    "test:codex-native-web": "node scripts/codex-native-web-smoke.mjs",
    "test:image-native": "npm run build && node scripts/image-native-smoke.mjs",
    "test:codex-readonly": "node scripts/codex-readonly-smoke.mjs",
    "test:codex-existing": "node scripts/codex-existing-thread-smoke.mjs",
    "check:env": "node scripts/check-env.mjs .env",
    "auth:dws-bot": "node scripts/dws-bot-login.mjs",
    "generate:codex-schema": "codex app-server generate-ts --out schemas/codex",
    "generate:codex-json-schema": "codex app-server generate-json-schema --out schemas/codex",
    "generate:dws-capabilities": "node scripts/generate-dws-capabilities.mjs",
    "test:knowledge:live": "npm run build && node --env-file=.env scripts/knowledge-live-smoke.mjs",
    "test:knowledge:postgres": "npm run build && node scripts/knowledge-postgres-smoke.mjs",
    "test:knowledge:queue": "npm run build && node scripts/knowledge-queue-smoke.mjs",
    "knowledge:ingest:all": "npm run build && node --env-file=.env scripts/knowledge-ingest-all.mjs",
    "test:knowledge:rerank": "npm run build && node --env-file=.env scripts/knowledge-rerank-smoke.mjs",
    "test:knowledge:pdf": "npm run build && node --env-file=.env scripts/knowledge-pdf-smoke.mjs",
    "test:knowledge:vision": "npm run build && node --env-file=.env scripts/knowledge-vision-smoke.mjs",
    "test:knowledge:answer": "npm run build && node --env-file=.env scripts/knowledge-answer-smoke.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "bullmq": "^5.58.0",
    "dingtalk-stream": "^2.1.7-beta.1",
    "fastify": "^5.6.1",
    "file-type": "^22.1.1",
    "ioredis": "^5.7.0",
    "officeparser": "^8.0.0",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "playwright": "1.64.1",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0",
    "ws": "^8.22.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
